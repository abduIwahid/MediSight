# WhyRisk ML service environment - copy to .env and fill in real values.
# The FastAPI app reads ML_SERVICE_API_KEY and ALLOWED_ORIGINS.
# DATABASE_URL is only used by the seeding script (model_training/seed_db.py).

# API key that callers must send in the X-API-Key header on /predict,
# /explain, /retrain and /drift-status. If left unset, the service runs
# in an explicitly logged DEV MODE with no authentication - local use only.
ML_SERVICE_API_KEY=

# Comma-separated CORS origins allowed to call the API from a browser.
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS=

# PostgreSQL connection string for seeding demo data (development only)
DATABASE_URL=
