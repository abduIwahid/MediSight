# MediSight frontend environment - copy to .env.local and fill in real values.
# Never commit .env.local or real keys.

# Supabase (required) - Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (admin API routes). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ML service base URL - the ONLY spelling the frontend reads.
# Used server-side by the Next.js API routes and admin pages; never exposed
# to the browser.
ML_SERVICE_URL=
# ML service API key - server-side only. Sent as the X-API-Key header to the
# FastAPI service; must match the ML service's ML_SERVICE_API_KEY.
ML_SERVICE_API_KEY=

# Public site URL - used to build auth redirect links (login / signup / reset)
NEXT_PUBLIC_SITE_URL=

# Gemini API key - server-side only, used by the AI assistant chat route
GEMINI_API_KEY=
